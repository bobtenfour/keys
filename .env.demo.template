# Copy to .env.demo on the Droplet (never commit .env.demo).
# DEMO / EVALUATION ONLY — KeyInventory beside DentalInventory on the same SQL Server instance.
# Destructive KeyInventoryDemo-only reset: docker/reset-keyinventory-demo.sh (see docker/README-demo.md).
# Normal compose up does NOT drop KeyInventoryDemo.

# SQL Server SA password for the existing dentalinventory-demo-sql container.
MSSQL_SA_PASSWORD=

# Host port published for KeyInventory Web (must not conflict with DentalInventory 8080).
DEMO_HOST_PORT=8081

# Container listen port (mapped from DEMO_HOST_PORT).
PORT=8080

# Demo evaluation login (ASP.NET Identity). Bootstrap stays disabled in committed appsettings.Demo.json;
# compose enables it via LocalBootstrapAdmin__Enabled.
LocalBootstrapAdmin__Enabled=true
LocalBootstrapAdmin__UserName=user
LocalBootstrapAdmin__Email=user@demo.local
LocalBootstrapAdmin__Password=
