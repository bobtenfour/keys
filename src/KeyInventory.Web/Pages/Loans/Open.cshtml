@page
@model KeyInventory.Web.Pages.Loans.OpenModel
@{
    ViewData["Title"] = "Open Loans";
}

<section class="panel">
    <h1>Open Loans</h1>
    <p class="lede">Loans that have not yet been returned or cancelled.</p>

    @if (Model.Loans.Count == 0)
    {
        <p class="empty">There are no open loans.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Loan</th>
                        <th>Key</th>
                        <th>Borrower</th>
                        <th>Issued (UTC)</th>
                        <th>Due (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (LoanListItem loan in Model.Loans)
                {
                    <tr>
                        <td>@loan.LoanCode</td>
                        <td>@loan.CatalogKeyCode</td>
                        <td>@loan.BorrowerPartyReference</td>
                        <td>@loan.IssuedAtUtc.ToString("u")</td>
                        <td>@loan.DueAtUtc.ToString("u")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
