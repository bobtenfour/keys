@page
@model KeyInventory.Web.Pages.Loans.IssueModel
@{
    ViewData["Title"] = "Issue Loan";
}

<section class="panel">
    <h1>Issue Loan</h1>
    <p class="lede">Issue a controlled key to a borrower party. Timestamps must be UTC with a zero offset.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="message message-error">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <p class="message message-success">@Model.SuccessMessage</p>
    }

    @if (Model.KeyOptions.Count == 0)
    {
        <p class="empty">Create an active key before issuing a loan.</p>
        <p><a class="button" asp-page="/Keys/Create">Create Key</a></p>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>
                Loan code
                <input asp-for="LoanCode" autocomplete="off" required />
            </label>
            <label>
                Key
                <select asp-for="CatalogKeyCode" asp-items="Model.KeyOptions" required></select>
            </label>
            <label>
                Borrower party reference
                <input asp-for="BorrowerPartyReference" autocomplete="off" required />
            </label>
            <label>
                Issued at (UTC)
                <input asp-for="IssuedAtUtcText" autocomplete="off" required />
                <span class="hint">Example: 2026-08-03T12:00:00+00:00</span>
            </label>
            <label>
                Due at (UTC)
                <input asp-for="DueAtUtcText" autocomplete="off" required />
            </label>
            <button type="submit">Issue loan</button>
        </form>
    }
</section>
