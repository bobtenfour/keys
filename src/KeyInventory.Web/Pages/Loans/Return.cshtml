@page
@model KeyInventory.Web.Pages.Loans.ReturnModel
@{
    ViewData["Title"] = "Complete Return";
}

<section class="panel">
    <h1>Complete Return</h1>
    <p class="lede">Complete an open loan when the key is returned to organizational control.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="message message-error">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <p class="message message-success">@Model.SuccessMessage</p>
    }

    @if (Model.OpenLoanOptions.Count == 0)
    {
        <p class="empty">There are no open loans to return.</p>
        <p><a class="button" asp-page="/Loans/Issue">Issue Loan</a></p>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>
                Return code
                <input asp-for="ReturnCode" autocomplete="off" required />
            </label>
            <label>
                Open loan
                <select asp-for="LoanCode" asp-items="Model.OpenLoanOptions" required></select>
            </label>
            <label>
                Returned at (UTC)
                <input asp-for="ReturnedAtUtcText" autocomplete="off" required />
                <span class="hint">Example: 2026-08-03T15:30:00+00:00</span>
            </label>
            <button type="submit">Complete return</button>
        </form>
    }
</section>
