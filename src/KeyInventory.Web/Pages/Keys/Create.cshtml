@page
@model KeyInventory.Web.Pages.Keys.CreateModel
@{
    ViewData["Title"] = "Create Key";
}

<section class="panel">
    <h1>Create Key</h1>
    <p class="lede">Register a controlled key with a catalog code and key type.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="message message-error">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <p class="message message-success">@Model.SuccessMessage</p>
    }

    <form method="post" class="form-grid">
        <label>
            Catalog key code
            <input asp-for="CatalogKeyCode" autocomplete="off" required />
        </label>
        <label>
            Key type code
            <input asp-for="TypeCode" autocomplete="off" required />
            <span class="hint">If the type does not exist yet, it will be created.</span>
        </label>
        <button type="submit">Create key</button>
    </form>
</section>
