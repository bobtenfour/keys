@page
@model KeyInventory.Web.Pages.Keys.IndexModel
@{
    ViewData["Title"] = "Keys";
}

<section class="panel">
    <h1>Keys</h1>
    <p class="lede">Cataloged keys available for loan issuance.</p>
    <p><a class="button" asp-page="/Keys/Create">Create Key</a></p>

    @if (Model.Keys.Count == 0)
    {
        <p class="empty">No keys have been created yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Catalog key</th>
                        <th>Type</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (KeyAssetListItem key in Model.Keys)
                {
                    <tr>
                        <td>@key.CatalogKeyCode</td>
                        <td>@key.TypeCode</td>
                        <td>@(key.IsActive ? "Yes" : "No")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
