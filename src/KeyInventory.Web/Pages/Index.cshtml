@page
@model KeyInventory.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Operations";
    ViewData["NavSection"] = "home";
}

<header class="page-header">
    <h1>Operations</h1>
    <p class="lede">What requires your attention now?</p>
</header>

<section class="card stack" aria-labelledby="quick-actions-title">
    <h2 id="quick-actions-title" class="section-title">Quick Actions</h2>
    <div class="quick-actions">
        <a class="action-card" asp-page="/Operations/Issue">
            <strong>Issue Key</strong>
            <span>Hand a key to a borrower</span>
        </a>
        <a class="action-card" asp-page="/Operations/Receive">
            <strong>Receive Key</strong>
            <span>Complete an active issue</span>
        </a>
        <a class="action-card" asp-page="/Catalog/Register">
            <strong>Register Key</strong>
            <span>Add a key to the catalog</span>
        </a>
        <a class="action-card" asp-page="/Operations/Find">
            <strong>Find Key</strong>
            <span>Locate a key by search</span>
        </a>
    </div>
</section>

<section class="stack" aria-labelledby="summary-title" style="margin-top: 1.5rem;">
    <h2 id="summary-title" class="section-title">Operational summary</h2>
    <div class="summary-grid">
        <article class="stat-card">
            <span class="label">Active Loans</span>
            <span class="value">@Model.ActiveLoanCount</span>
        </article>
        <article class="stat-card @(Model.OverdueCount > 0 ? "is-danger" : null)">
            <span class="label">Overdue</span>
            <span class="value">@Model.OverdueCount</span>
        </article>
        <article class="stat-card">
            <span class="label">Keys Available</span>
            <span class="value">@Model.KeysAvailableCount</span>
        </article>
    </div>
</section>

<section class="card stack" aria-labelledby="activity-title" style="margin-top: 1.5rem;">
    <h2 id="activity-title" class="section-title">Recent Activity</h2>
    @if (Model.RecentActivity.Count == 0)
    {
        <div class="empty-state">
            <strong>No recent activity</strong>
            Issue or receive a key to see operational history here.
        </div>
    }
    else
    {
        <ul class="activity-list">
            @foreach (var item in Model.RecentActivity)
            {
                <li>
                    <span>
                        <span class="badge @(item.Kind == "Received" ? "badge-received" : "badge-active")">@item.Kind</span>
                        @item.Description
                    </span>
                    <span class="activity-meta">@item.OccurredAtUtc.ToString("u")</span>
                </li>
            }
        </ul>
    }
</section>
