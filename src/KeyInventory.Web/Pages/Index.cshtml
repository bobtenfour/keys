@page
@model KeyInventory.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Operations";
    ViewData["NavSection"] = "home";
}

<div class="ops-home">
    <header class="page-header page-header-compact">
        <h1>Operations</h1>
        <p class="lede">What requires your attention now?</p>
    </header>

    @if (Model.Readiness.IsFirstUse)
    {
        <partial name="_OperationalReadiness" model="Model.Readiness" />
    }

    <section class="summary-band" aria-labelledby="summary-title">
        <h2 id="summary-title" class="visually-hidden">Operational summary</h2>
        <div class="summary-grid summary-grid-emphasis">
            <article class="stat-card @(Model.ActiveLoanCount > 0 ? "is-attention" : null)">
                <span class="value">@Model.ActiveLoanCount</span>
                <span class="label">Active Loans</span>
            </article>
            <article class="stat-card @(Model.OverdueCount > 0 ? "is-overdue" : null)">
                <span class="value">@Model.OverdueCount</span>
                <span class="label">Overdue</span>
            </article>
            <article class="stat-card is-success">
                <span class="value">@Model.KeysAvailableCount</span>
                <span class="label">Keys Available</span>
            </article>
        </div>
    </section>

    @if (Model.Readiness.IsFirstUse)
    {
        <section class="card card-compact" aria-labelledby="setup-title">
            <h2 id="setup-title" class="section-title">First-time setup</h2>
            <p class="lede">Create departments, rooms, and key types in any order. Then add workforce members, work assignments, and register keys before issuing.</p>
            <div class="quick-actions">
                <a class="action-card" asp-page="/Administration/Departments/Add">
                    <span class="action-copy"><strong>Departments</strong><span>Organizational units for members</span></span>
                </a>
                <a class="action-card" asp-page="/Administration/Rooms/Add">
                    <span class="action-copy"><strong>Rooms</strong><span>Places keys may open</span></span>
                </a>
                <a class="action-card" asp-page="/Catalog/KeyTypes">
                    <span class="action-copy"><strong>Key Types</strong><span>Classify physical keys</span></span>
                </a>
                <a class="action-card" asp-page="/Administration/WorkforceMembers/Add">
                    <span class="action-copy"><strong>Workforce Members</strong><span>People eligible for keys</span></span>
                </a>
                <a class="action-card" asp-page="/Administration/WorkAssignments/Add">
                    <span class="action-copy"><strong>Work Assignments</strong><span>Member-to-room links</span></span>
                </a>
                <a class="action-card" asp-page="/Catalog/Register">
                    <span class="action-copy"><strong>Register Key</strong><span>Add keys to the catalog</span></span>
                </a>
            </div>
        </section>
    }

    <section class="card card-compact" aria-labelledby="quick-actions-title">
        <h2 id="quick-actions-title" class="section-title">Daily custody</h2>
        <div class="quick-actions">
            <a class="action-card" asp-page="/Operations/Issue">
                <span class="action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 7h9a3 3 0 0 1 0 6h-3"/><path d="M14 13H7a3 3 0 0 1 0-6h2"/><circle cx="16.5" cy="10" r="1.2" fill="currentColor" stroke="none"/></svg>
                </span>
                <span class="action-copy">
                    <strong>Issue Key</strong>
                    <span>Hand a key to a borrower</span>
                </span>
            </a>
            <a class="action-card" asp-page="/Operations/Receive">
                <span class="action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 4v10"/><path d="m8 10 4 4 4-4"/><path d="M5 18h14"/></svg>
                </span>
                <span class="action-copy">
                    <strong>Receive Key</strong>
                    <span>Complete an active issue</span>
                </span>
            </a>
            <a class="action-card" asp-page="/Operations/Active">
                <span class="action-copy"><strong>Active Loans</strong><span>Keys currently issued</span></span>
            </a>
            <a class="action-card" asp-page="/Operations/Find">
                <span class="action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
                </span>
                <span class="action-copy">
                    <strong>Find Key</strong>
                    <span>Locate a key quickly</span>
                </span>
            </a>
        </div>
    </section>

    <section class="card card-compact" aria-labelledby="activity-title">
        <h2 id="activity-title" class="section-title">Recent Activity</h2>
        @if (Model.RecentActivity.Count == 0)
        {
            <div class="empty-state">
                <strong>No recent activity</strong>
                @if (Model.Readiness.Snapshot.CanIssueKey)
                {
                    <span>Issue your first key to start the operational timeline.</span>
                }
                else
                {
                    <span>Complete setup above, then issue your first key.</span>
                }
                <div class="form-actions">
                    @if (Model.Readiness.Snapshot.CanIssueKey)
                    {
                        <a class="btn btn-primary" asp-page="/Operations/Issue">Issue Key</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-page="@Model.Readiness.NextActionPage">@Model.Readiness.NextActionTitle</a>
                    }
                </div>
            </div>
        }
        else
        {
            <ul class="activity-list">
                @foreach (var item in Model.RecentActivity)
                {
                    string badgeClass = item.BadgeKind switch
                    {
                        "Success" => "badge-success",
                        "Warning" => "badge-warning",
                        "Overdue" => "badge-overdue",
                        _ => "badge-attention"
                    };
                    <li>
                        <div class="activity-main">
                            <span class="badge @badgeClass">@item.BadgeKind</span>
                            <span class="activity-primary">@item.Description</span>
                        </div>
                        <span class="activity-secondary">@OperatorTimestampFormatter.ToFriendlyDisplay(item.OccurredAtUtc)</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>
