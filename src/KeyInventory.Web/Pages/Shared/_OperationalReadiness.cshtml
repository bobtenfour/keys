@model KeyInventory.Web.Presentation.OperationalReadinessViewModel
@{
    var s = Model.Snapshot;
}

@if (!s.CanIssueKey)
{
    <section class="card readiness-panel" aria-labelledby="issue-prereq-title">
        <h2 id="issue-prereq-title" class="section-title">Issue Key unavailable</h2>
        <p class="lede">@Model.NextActionDescription</p>

        <div class="readiness-next">
            <strong>Resolve next:</strong> @Model.NextActionTitle
            <div class="form-actions">
                <a class="btn btn-primary" asp-page="@Model.NextActionPage">@Model.NextActionTitle</a>
            </div>
        </div>

        <ul class="readiness-checklist">
            @if (!s.HasDepartment)
            {
                <li class="is-missing">
                    <span>Department</span>
                    <span>Required</span>
                    <a asp-page="/Administration/Departments/Add">Create</a>
                </li>
            }
            @if (!s.HasRoom)
            {
                <li class="is-missing">
                    <span>Room</span>
                    <span>Required</span>
                    <a asp-page="/Administration/Rooms/Add">Create</a>
                </li>
            }
            @if (!s.HasKeyType)
            {
                <li class="is-missing">
                    <span>Key type</span>
                    <span>Required</span>
                    <a asp-page="/Catalog/KeyTypes">Create</a>
                </li>
            }
            @if (!s.HasWorkforceMember)
            {
                <li class="is-missing">
                    <span>Workforce member</span>
                    <span>Required</span>
                    <a asp-page="/Administration/WorkforceMembers/Add">Create</a>
                </li>
            }
            @if (!s.HasWorkAssignment)
            {
                <li class="is-missing">
                    <span>Work assignment</span>
                    <span>Required</span>
                    <a asp-page="/Administration/WorkAssignments/Add">Create</a>
                </li>
            }
            @if (!s.HasKey)
            {
                <li class="is-missing">
                    <span>Registered key</span>
                    <span>Required</span>
                    <a asp-page="/Catalog/Register">Register</a>
                </li>
            }
        </ul>
    </section>
}
