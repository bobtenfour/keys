@{
    string section = ViewData["NavSection"] as string ?? string.Empty;
    string page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · KeyInventory</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="shell site-header-primary">
            <a class="brand" asp-page="/Index" aria-label="KeyInventory home">
                <span class="brand-mark">Key</span><span class="brand-rest">Inventory</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="primary-nav" aria-label="Primary">
                    <a asp-page="/Index" class="@(section == "home" ? "is-active" : null)">Home</a>
                    <a asp-page="/Operations/Issue" class="@(section == "operations" ? "is-active" : null)">Operations</a>
                    <a asp-page="/Catalog/Keys" class="@(section == "catalog" ? "is-active" : null)">Catalog</a>
                    <a asp-page="/Reports/Index" class="@(section == "reports" ? "is-active" : null)">Reports</a>
                    <a asp-page="/Administration/Index" class="@(section == "administration" ? "is-active" : null)">Administration</a>
                </nav>
                <div class="header-tools">
                    <form class="global-search" method="get" asp-page="/Operations/Find" role="search" aria-label="Search keys">
                        <input type="search"
                               name="q"
                               placeholder="Search by KEY #, MEDECO, or type..."
                               aria-label="Search by KEY #, MEDECO, or type"
                               value="@Context.Request.Query["q"]" />
                        <button type="submit">Search</button>
                    </form>
                    <div class="header-session">
                        <span class="session-label">@User.Identity?.Name</span>
                        <form method="post" asp-page="/Account/Logout" class="inline-form">
                            <button type="submit" class="btn-link">Log out</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <nav class="primary-nav" aria-label="Primary">
                    <a asp-page="/Account/Login">Log in</a>
                </nav>
            }
        </div>
        @if (User.Identity?.IsAuthenticated == true && section == "operations")
        {
            <div class="subnav">
                <nav class="shell" aria-label="Operations">
                    <a asp-page="/Operations/Issue" class="@(page.Contains("/Operations/Issue", StringComparison.Ordinal) ? "is-active" : null)">Issue Key</a>
                    <a asp-page="/Operations/Receive" class="@(page.Contains("/Operations/Receive", StringComparison.Ordinal) ? "is-active" : null)">Receive Key</a>
                    <a asp-page="/Operations/Active" class="@(page.Contains("/Operations/Active", StringComparison.Ordinal) ? "is-active" : null)">Active Loans</a>
                    <a asp-page="/Operations/History" class="@(page.Contains("/Operations/History", StringComparison.Ordinal) ? "is-active" : null)">History</a>
                </nav>
            </div>
        }
        @if (User.Identity?.IsAuthenticated == true && section == "catalog")
        {
            <div class="subnav">
                <nav class="shell" aria-label="Catalog">
                    <a asp-page="/Catalog/Keys" class="@(page.Contains("/Catalog/Keys", StringComparison.Ordinal) ? "is-active" : null)">Keys</a>
                    <a asp-page="/Catalog/KeyTypes" class="@(page.Contains("/Catalog/KeyTypes", StringComparison.Ordinal) ? "is-active" : null)">Key Types</a>
                    <a asp-page="/Catalog/Register" class="@(page.Contains("/Catalog/Register", StringComparison.Ordinal) ? "is-active" : null)">Register Key</a>
                </nav>
            </div>
        }
        @if (User.Identity?.IsAuthenticated == true && section == "reports")
        {
            <div class="subnav">
                <nav class="shell" aria-label="Reports">
                    <a asp-page="/Reports/CurrentKeyHolders" class="@(page.Contains("/Reports/CurrentKeyHolders", StringComparison.Ordinal) ? "is-active" : null)">Current Key Holders</a>
                    <a asp-page="/Reports/KeysByWorkforceMember" class="@(page.Contains("/Reports/KeysByWorkforceMember", StringComparison.Ordinal) ? "is-active" : null)">Keys by Member</a>
                    <a asp-page="/Reports/ActiveLoans" class="@(page.Contains("/Reports/ActiveLoans", StringComparison.Ordinal) ? "is-active" : null)">Active Loans</a>
                    <a asp-page="/Reports/OverdueKeys" class="@(page.Contains("/Reports/OverdueKeys", StringComparison.Ordinal) ? "is-active" : null)">Overdue Keys</a>
                    <a asp-page="/Reports/KeyHistory" class="@(page.Contains("/Reports/KeyHistory", StringComparison.Ordinal) ? "is-active" : null)">Key History</a>
                    <a asp-page="/Reports/OutstandingByWorkforceStatus" class="@(page.Contains("/Reports/OutstandingByWorkforceStatus", StringComparison.Ordinal) ? "is-active" : null)">Outstanding by Status</a>
                    <a asp-page="/Reports/KeyCatalog" class="@(page.Contains("/Reports/KeyCatalog", StringComparison.Ordinal) ? "is-active" : null)">Key Catalog</a>
                </nav>
            </div>
        }
        @if (User.Identity?.IsAuthenticated == true && section == "administration")
        {
            <div class="subnav">
                <nav class="shell" aria-label="Administration">
                    <a asp-page="/Administration/Departments/Index" class="@(page.Contains("/Administration/Departments", StringComparison.Ordinal) ? "is-active" : null)">Departments</a>
                    <a asp-page="/Administration/Rooms/Index" class="@(page.Contains("/Administration/Rooms", StringComparison.Ordinal) ? "is-active" : null)">Rooms</a>
                    <a asp-page="/Administration/WorkforceMembers/Index" class="@(page.Contains("/Administration/WorkforceMembers", StringComparison.Ordinal) ? "is-active" : null)">Workforce Members</a>
                    <a asp-page="/Administration/WorkAssignments/Index" class="@(page.Contains("/Administration/WorkAssignments", StringComparison.Ordinal) ? "is-active" : null)">Work Assignments</a>
                    <a asp-page="/Administration/AuditTrail" class="@(page.Contains("/Administration/AuditTrail", StringComparison.Ordinal) ? "is-active" : null)">Audit Trail</a>
                </nav>
            </div>
        }
    </header>
    <main class="shell site-main">
        @RenderBody()
    </main>
</body>
</html>