<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · KeyInventory</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="shell">
            <a class="brand" asp-page="/Index">KeyInventory</a>
            <nav class="site-nav" aria-label="Workflow">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Keys/Index">Keys</a>
                    <a asp-page="/Keys/Create">Create Key</a>
                    <a asp-page="/Loans/Issue">Issue Loan</a>
                    <a asp-page="/Loans/Open">Open Loans</a>
                    <a asp-page="/Loans/Return">Complete Return</a>
                    <a asp-page="/Loans/Returned">Returned Loans</a>
                    <form method="post" asp-page="/Account/Logout" class="inline-form">
                        <button type="submit" class="link-button">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login">Log in</a>
                }
            </nav>
        </div>
    </header>
    <main class="shell site-main">
        @RenderBody()
    </main>
</body>
</html>
