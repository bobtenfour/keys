@page
@model KeyInventory.Web.Pages.Operations.IssueModel
@{
    ViewData["Title"] = "Issue Key";
    ViewData["NavSection"] = "operations";
    bool showForm = Model.HasAvailableCopies
        && Model.Readiness.Snapshot.CanIssueKey
        && string.IsNullOrWhiteSpace(Model.SuccessMessage);
}

<header class="page-header">
    <h1>Issue Key</h1>
    <p class="lede">Hand a MEDECO key to an eligible key holder. Search the key first, then the holder.</p>
</header>

@if (!Model.Readiness.Snapshot.CanIssueKey && string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <partial name="_OperationalReadiness" model="Model.Readiness" />
}

<section class="card form-card form-card-operator">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
        <div class="next-actions">
            <a class="btn btn-primary" asp-page="/Operations/Issue">Issue another key</a>
            <a class="btn btn-secondary" asp-page="/Operations/Receive">Receive key</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    }

    @if (!Model.HasAvailableCopies && Model.Readiness.Snapshot.CanIssueKey && string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="empty-state">
            <strong>No physical copies available to issue</strong>
            Create an active MEDECO key that is not already issued, then return here.
        </div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-page="/Catalog/Register">Create Key</a>
            <a class="btn btn-secondary" asp-page="/Operations/Active">View Active Loans</a>
        </div>
    }
    else if (showForm)
    {
        <form method="post" class="form-grid" id="issue-key-form">
            <div class="form-span-2">
                <label>
                    KEY # / MEDECO
                    <div class="searchable-combobox"
                         data-searchable-combobox
                         data-search-url="/Operations/Issue?handler=SearchIssuableCopies"
                         data-value-field="keyNumber|medecoKeyCode"
                         data-value-separator="|"
                         data-display-fields="keyNumber,medecoKeyCode"
                         data-display-separator=" / "
                         data-secondary-fields="classification,rooms">
                        <input type="text"
                               class="searchable-combobox-input"
                               data-role="combobox-input"
                               placeholder="Search KEY # or MEDECO..."
                               autocomplete="off"
                               value="@Model.SelectedKeyDisplay"
                               aria-label="Search issuable KEY # / MEDECO" />
                        <button type="button" class="searchable-combobox-toggle" data-role="combobox-toggle" aria-label="Browse issuable keys">▾</button>
                        <input type="hidden" data-role="combobox-value" />
                        <input type="hidden" asp-for="KeyNumber" data-role="combobox-value-part" data-part-index="0" />
                        <input type="hidden" asp-for="MedecoKeyCode" data-role="combobox-value-part" data-part-index="1" />
                        <ul class="searchable-combobox-panel" data-role="combobox-panel" role="listbox"></ul>
                    </div>
                    <span class="hint">Type KEY # or MEDECO. Only issuable (available, active) keys appear. Nothing is selected automatically.</span>
                </label>
            </div>

            <label>
                Classification
                <input type="text" value="@Model.ClassificationDisplay" readonly placeholder="—" />
                <span class="hint">Derived from the selected KEY #.</span>
            </label>
            <label>
                Access
                <input type="text" value="@Model.OpenedRoomsDisplay" readonly />
                <span class="hint">Derived from the KEY #. Not entered at issue time.</span>
            </label>

            <div class="form-span-2">
                <label>
                    Key holder
                    <div class="searchable-combobox"
                         data-searchable-combobox
                         data-search-url="/Operations/Issue?handler=SearchHolders"
                         data-value-field="workforceMemberCode"
                         data-display-fields="display">
                        <input type="text"
                               class="searchable-combobox-input"
                               data-role="combobox-input"
                               placeholder="Search by name or UIN..."
                               autocomplete="off"
                               value="@Model.SelectedHolderDisplay"
                               aria-label="Search eligible key holder" />
                        <button type="button" class="searchable-combobox-toggle" data-role="combobox-toggle" aria-label="Browse eligible key holders">▾</button>
                        <input type="hidden" asp-for="WorkforceMemberCode" data-role="combobox-value" />
                        <ul class="searchable-combobox-panel" data-role="combobox-panel" role="listbox"></ul>
                    </div>
                    <span class="hint">Eligible key holders only (active, current room assignment, key-eligible worker type). Nothing is selected automatically.</span>
                </label>
            </div>

            <label>
                For
                <select asp-for="JustificationKind" id="issue-for-kind" required>
                    <option value="">Select justification...</option>
                    <option value="Department">Department</option>
                    <option value="Room">Room</option>
                </select>
            </label>
            <label id="issue-for-department-label">
                Department
                <select asp-for="JustificationCode" asp-items="Model.DepartmentOptions" id="issue-for-department">
                    <option value="">Select a department...</option>
                </select>
            </label>
            <label id="issue-for-room-label">
                Room
                <select asp-items="Model.RoomOptions" id="issue-for-room">
                    <option value="">Select a room...</option>
                </select>
            </label>
            <label>
                Issued
                <input asp-for="IssuedLocalText" autocomplete="off" required />
                <span class="hint">Operator local time. Example: @OperatorTimestampFormatter.ToAbsoluteDisplay(DateTimeOffset.UtcNow)</span>
            </label>
            <label>
                Due
                <input asp-for="DueLocalText" autocomplete="off" required />
                <span class="hint">Operator local time.</span>
            </label>
            <label>
                Loan code
                <input asp-for="LoanCode" autocomplete="off" required />
                <span class="hint">Unique loan identity required by current authority. Automatic generation is not authorized.</span>
            </label>
            <div class="form-actions form-span-2">
                <button type="submit" class="btn btn-primary">Issue Key</button>
                <a class="btn btn-secondary" asp-page="/Index">Cancel</a>
            </div>
        </form>
        <script>
            (function () {
                const kindEl = document.getElementById('issue-for-kind');
                const deptLabel = document.getElementById('issue-for-department-label');
                const roomLabel = document.getElementById('issue-for-room-label');
                const deptSelect = document.getElementById('issue-for-department');
                const roomSelect = document.getElementById('issue-for-room');
                if (!kindEl || !deptSelect || !roomSelect) { return; }

                function syncJustification() {
                    const isRoom = kindEl.value === 'Room';
                    const isDept = kindEl.value === 'Department';
                    deptLabel.hidden = !isDept;
                    roomLabel.hidden = !isRoom;
                    deptSelect.disabled = !isDept;
                    roomSelect.disabled = !isRoom;
                    deptSelect.name = isDept ? 'JustificationCode' : '';
                    roomSelect.name = isRoom ? 'JustificationCode' : '';
                    if (isRoom) {
                        deptSelect.removeAttribute('required');
                        roomSelect.setAttribute('required', 'required');
                    } else if (isDept) {
                        roomSelect.removeAttribute('required');
                        deptSelect.setAttribute('required', 'required');
                    } else {
                        deptSelect.removeAttribute('required');
                        roomSelect.removeAttribute('required');
                        deptSelect.value = '';
                        roomSelect.value = '';
                    }
                }

                kindEl.addEventListener('change', syncJustification);
                syncJustification();
            })();
        </script>
    }
</section>
