@page
@model KeyInventory.Web.Pages.Operations.IssueModel
@{
    ViewData["Title"] = "Issue Key";
    ViewData["NavSection"] = "operations";
    bool showForm = Model.HasAvailableCopies
        && Model.Readiness.Snapshot.CanIssueKey
        && string.IsNullOrWhiteSpace(Model.SuccessMessage);
}

<header class="page-header">
    <h1>Issue Key</h1>
    <p class="lede">Hand a physical MEDECO copy to an eligible key holder.</p>
</header>

@if (!Model.Readiness.Snapshot.CanIssueKey && string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <partial name="_OperationalReadiness" model="Model.Readiness" />
}

<section class="card form-card form-card-operator">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
        <div class="next-actions">
            <a class="btn btn-primary" asp-page="/Operations/Issue">Issue another key</a>
            <a class="btn btn-secondary" asp-page="/Operations/Receive">Receive key</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    }

    @if (!Model.HasAvailableCopies && Model.Readiness.Snapshot.CanIssueKey && string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="empty-state">
            <strong>No physical copies available to issue</strong>
            Register an active MEDECO copy that is not already issued, then return here.
        </div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-page="/Catalog/Register">Register Key</a>
            <a class="btn btn-secondary" asp-page="/Operations/Active">View Active Loans</a>
        </div>
    }
    else if (showForm)
    {
        <div class="form-grid">
            <div class="form-span-2">
                <label>
                    Key holder
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedHolderDisplay))
                    {
                        <input type="text" value="@Model.SelectedHolderDisplay" readonly />
                    }
                    else
                    {
                        <span class="hint">Search by name or UIN. Eligible matches only. Nothing is selected automatically.</span>
                    }
                </label>

                @if (string.IsNullOrWhiteSpace(Model.SelectedHolderDisplay))
                {
                    <form method="post" asp-page="/Operations/Issue" asp-page-handler="SearchHolders" class="form-grid">
                        <label>
                            Search
                            <input asp-for="HolderSearchText" placeholder="Search by name or UIN..." autocomplete="off" required />
                        </label>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-secondary">Search</button>
                        </div>
                    </form>

                    @if (Model.HolderSearchPerformed)
                    {
                        if (Model.HolderMatches.Count == 0)
                        {
                            <div class="empty-state">
                                <strong>No eligible key holders matched</strong>
                                Refine the name or UIN search.
                            </div>
                        }
                        else
                        {
                            <ul class="activity-list" aria-label="Matching key holders">
                                @foreach (var match in Model.HolderMatches)
                                {
                                    string label = PartyHolderDisplayFormatter.Format(match.FirstName, match.LastName, match.Uin);
                                    <li>
                                        <div class="activity-main">
                                            <span class="activity-primary">@label</span>
                                        </div>
                                        <form method="post" asp-page="/Operations/Issue" asp-page-handler="SelectHolder">
                                            <input type="hidden" name="WorkforceMemberCode" value="@match.WorkforceMemberCode" />
                                            <button type="submit" class="btn btn-secondary">Select</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
                else
                {
                    <form method="post" asp-page="/Operations/Issue" asp-page-handler="ClearHolder" class="form-actions">
                        <button type="submit" class="btn btn-secondary">Change key holder</button>
                    </form>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SelectedHolderDisplay))
        {
            <form method="post" asp-page="/Operations/Issue" class="form-grid" id="issue-key-form">
                <input type="hidden" asp-for="WorkforceMemberCode" />
                <label>
                    KEY #
                    <select asp-for="KeyNumber" asp-items="Model.KeyNumberOptions" id="issue-key-number" required>
                        <option value="">Select a KEY #...</option>
                    </select>
                </label>
                <label>
                    MEDECO Key Code
                    <select asp-for="MedecoKeyCode" asp-items="Model.MedecoOptions" id="issue-medeco" required>
                        <option value="">Select an available MEDECO...</option>
                    </select>
                </label>
                <label>
                    Rooms opened
                    <input type="text" id="issue-rooms" value="@Model.OpenedRoomsDisplay" readonly />
                    <span class="hint">Derived from the KEY #. Not entered at issue time.</span>
                </label>
                <label>
                    For
                    <select asp-for="JustificationKind" id="issue-for-kind" required>
                        <option value="">Select justification...</option>
                        <option value="Department">Department</option>
                        <option value="Room">Room</option>
                    </select>
                </label>
                <label id="issue-for-department-label">
                    Department
                    <select asp-for="JustificationCode" asp-items="Model.DepartmentOptions" id="issue-for-department">
                        <option value="">Select a department...</option>
                    </select>
                </label>
                <label id="issue-for-room-label">
                    Room
                    <select asp-items="Model.RoomOptions" id="issue-for-room">
                        <option value="">Select a room...</option>
                    </select>
                </label>
                <label>
                    Issued
                    <input asp-for="IssuedLocalText" autocomplete="off" required />
                    <span class="hint">Operator local time. Example: @OperatorTimestampFormatter.ToAbsoluteDisplay(DateTimeOffset.UtcNow)</span>
                </label>
                <label>
                    Due
                    <input asp-for="DueLocalText" autocomplete="off" required />
                    <span class="hint">Operator local time.</span>
                </label>
                <label>
                    Loan code
                    <input asp-for="LoanCode" autocomplete="off" required />
                    <span class="hint">Unique loan identity required by current authority. Automatic generation is not authorized.</span>
                </label>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Issue Key</button>
                    <a class="btn btn-secondary" asp-page="/Index">Cancel</a>
                </div>
            </form>
            <script type="application/json" id="issue-key-copy-data">@Html.Raw(Model.KeyCopyDataJson)</script>
            <script>
                (function () {
                    const keyCopyEl = document.getElementById('issue-key-copy-data');
                    const keyCopyData = keyCopyEl ? JSON.parse(keyCopyEl.textContent || '{}') : {};
                    const kindEl = document.getElementById('issue-for-kind');
                    const deptLabel = document.getElementById('issue-for-department-label');
                    const roomLabel = document.getElementById('issue-for-room-label');
                    const deptSelect = document.getElementById('issue-for-department');
                    const roomSelect = document.getElementById('issue-for-room');
                    const keyNumberEl = document.getElementById('issue-key-number');
                    const medecoEl = document.getElementById('issue-medeco');
                    const roomsEl = document.getElementById('issue-rooms');
                    if (!kindEl || !deptSelect || !roomSelect || !keyNumberEl || !medecoEl || !roomsEl) return;

                    function fillMedeco(choices, selected) {
                        const keep = selected || '';
                        medecoEl.innerHTML = '';
                        const empty = document.createElement('option');
                        empty.value = '';
                        empty.textContent = 'Select an available MEDECO...';
                        medecoEl.appendChild(empty);
                        (choices || []).forEach(function (choice) {
                            const opt = document.createElement('option');
                            opt.value = choice.code;
                            opt.textContent = choice.label || choice.code;
                            if (keep && keep.toLowerCase() === String(choice.code).toLowerCase()) {
                                opt.selected = true;
                            }
                            medecoEl.appendChild(opt);
                        });
                    }

                    function syncKeyCopy() {
                        const selected = keyNumberEl.value ? (keyCopyData[keyNumberEl.value] || { rooms: '—', medecos: [] }) : { rooms: '—', medecos: [] };
                        roomsEl.value = selected.rooms || '—';
                        fillMedeco(selected.medecos, keyNumberEl.value ? medecoEl.value : '');
                        if (!keyNumberEl.value) {
                            medecoEl.value = '';
                        }
                    }

                    function syncJustification() {
                        const isRoom = kindEl.value === 'Room';
                        const isDept = kindEl.value === 'Department';
                        deptLabel.hidden = !isDept;
                        roomLabel.hidden = !isRoom;
                        deptSelect.disabled = !isDept;
                        roomSelect.disabled = !isRoom;
                        deptSelect.name = isDept ? 'JustificationCode' : '';
                        roomSelect.name = isRoom ? 'JustificationCode' : '';
                        if (isRoom) {
                            deptSelect.removeAttribute('required');
                            roomSelect.setAttribute('required', 'required');
                        } else if (isDept) {
                            roomSelect.removeAttribute('required');
                            deptSelect.setAttribute('required', 'required');
                        } else {
                            deptSelect.removeAttribute('required');
                            roomSelect.removeAttribute('required');
                            deptSelect.value = '';
                            roomSelect.value = '';
                        }
                    }

                    kindEl.addEventListener('change', syncJustification);
                    keyNumberEl.addEventListener('change', function () {
                        medecoEl.value = '';
                        syncKeyCopy();
                    });
                    syncJustification();
                    syncKeyCopy();
                })();
            </script>
        }
    }
</section>
