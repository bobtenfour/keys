@page
@model KeyInventory.Web.Pages.Operations.ActiveModel
@{
    ViewData["Title"] = "Active Loans";
    ViewData["NavSection"] = "operations";
}

<header class="page-header">
    <h1>Active Loans</h1>
    <p class="lede">Keys currently issued and awaiting receive.</p>
</header>

<section class="card">
    <div class="toolbar">
        <a class="btn btn-primary" asp-page="/Operations/Issue">Issue Key</a>
        <a class="btn btn-secondary" asp-page="/Operations/Receive">Receive Key</a>
    </div>

    @if (Model.ActiveIssues.Count == 0)
    {
        <div class="empty-state">
            <strong>No active issues</strong>
            When a key is issued, it appears here until it is received.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Borrower</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.ActiveIssues)
                {
                    bool overdue = item.DueAtUtc < Model.UtcNow;
                    <tr>
                        <td>@item.CatalogKeyCode</td>
                        <td>@item.BorrowerPartyReference</td>
                        <td>@item.IssuedAtUtc.ToString("u")</td>
                        <td>@item.DueAtUtc.ToString("u")</td>
                        <td>
                            @if (overdue)
                            {
                                <span class="badge badge-overdue">Overdue</span>
                            }
                            else
                            {
                                <span class="badge badge-active">Active</span>
                            }
                        </td>
                        <td><a asp-page="/Operations/Receive">Receive</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
