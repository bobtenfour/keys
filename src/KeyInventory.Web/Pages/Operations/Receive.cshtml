@page
@model KeyInventory.Web.Pages.Operations.ReceiveModel
@{
    ViewData["Title"] = "Receive Key";
    ViewData["NavSection"] = "operations";
}

<header class="page-header">
    <h1>Receive Key</h1>
    <p class="lede">Bring an issued key back under organizational control. Search open custody first.</p>
</header>

<section class="card form-card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
        <div class="next-actions">
            <a class="btn btn-primary" asp-page="/Operations/Receive">Receive another key</a>
            <a class="btn btn-secondary" asp-page="/Operations/Issue">Issue key</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    }
    else
    {
        <form method="post" class="form-grid">
            <div class="form-span-2">
                <label>
                    Active issue
                    <div class="searchable-combobox"
                         data-searchable-combobox
                         data-search-url="/Operations/Receive?handler=SearchOpenCustody"
                         data-value-field="loanCode"
                         data-display-fields="keyNumber,medecoKeyCode,holder"
                         data-secondary-fields="classification,uin">
                        <input type="text"
                               class="searchable-combobox-input"
                               data-role="combobox-input"
                               placeholder="Search KEY #, MEDECO, holder name, or UIN..."
                               autocomplete="off"
                               value="@Model.SelectedDisplay"
                               aria-label="Search open custody" />
                        <button type="button" class="searchable-combobox-toggle" data-role="combobox-toggle" aria-label="Browse open custody">▾</button>
                        <input type="hidden" asp-for="IssueReference" data-role="combobox-value" />
                        <ul class="searchable-combobox-panel" data-role="combobox-panel" role="listbox"></ul>
                    </div>
                    <span class="hint">Only currently issued keys appear. Nothing is selected automatically.</span>
                </label>
            </div>

            @if (Model.SelectedIssue is not null)
            {
                <dl class="search-person-identity form-span-2">
                    <div><dt>KEY # / MEDECO</dt><dd>@Model.SelectedDisplay</dd></div>
                    <div><dt>Classification</dt><dd>@Model.ClassificationDisplay</dd></div>
                    <div><dt>Holder</dt><dd>@Model.HolderDisplay</dd></div>
                    <div><dt>Issued</dt><dd>@Model.IssuedDisplay</dd></div>
                </dl>
            }

            <label>
                Receive reference
                <input asp-for="ReceiveReference" autocomplete="off" required />
                <span class="hint">Operator-supplied receive identity. Required by current authority.</span>
            </label>
            <label>
                Received
                <input asp-for="ReceivedLocalText" autocomplete="off" required />
                <span class="hint">Operator local time. Example: @OperatorTimestampFormatter.ToAbsoluteDisplay(DateTimeOffset.UtcNow)</span>
            </label>

            <div class="form-actions form-span-2">
                <button type="submit" class="btn btn-primary">Receive Key</button>
                <a class="btn btn-secondary" asp-page="/Index">Cancel</a>
            </div>
        </form>
    }
</section>
