@page
@model KeyInventory.Web.Pages.Operations.FindModel
@{
    ViewData["Title"] = "Find Key";
    ViewData["NavSection"] = "operations";
}

<header class="page-header">
    <h1>Find Key</h1>
    <p class="lede">Search will become the primary way to locate and navigate keys.</p>
</header>

<section class="card form-card">
    <div class="alert alert-info" role="status">
        Key search is not connected yet. Use Catalog and Operations lists until search is available.
    </div>

    <form method="get" class="form-grid" role="search">
        <label>
            Search
            <input type="search" name="q" value="@Model.Query" placeholder="Key code, borrower, or reference…" aria-label="Search keys" />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Search</button>
            <a class="btn btn-secondary" asp-page="/Catalog/Keys">Browse Keys</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="empty-state" style="margin-top: 1.5rem;">
            <strong>No search results yet</strong>
            “@Model.Query” was captured, but backend search is not enabled in this phase.
        </div>
    }
</section>
