@page
@using KeyInventory.Application.Catalog
@using KeyInventory.Application.Lookup
@model KeyInventory.Web.Pages.Operations.FindModel
@{
    ViewData["Title"] = "Find Key";
    ViewData["NavSection"] = "operations";
}

<header class="page-header page-header-compact">
    <h1>Find Key</h1>
    <p class="lede">Search by KEY #, MEDECO, Key Type, or Room # and see who currently holds each issued physical copy.</p>
</header>

<section class="card form-card">
    <form method="get" class="form-grid" role="search">
        <label>
            Search
            <input type="search"
                   name="q"
                   value="@Model.Query"
                   placeholder="Search by KEY #, MEDECO, Key Type, or Room #..."
                   aria-label="Search by KEY #, MEDECO, Key Type, or Room #" />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Search</button>
            <a class="btn btn-secondary" asp-page="/Catalog/Keys">Browse Keys</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    </form>

    @if (Model.SearchSubmitted)
    {
        @if (Model.Results.Count == 0)
        {
            <div class="empty-state" style="margin-top: 1rem;">
                <strong>No matching keys</strong>
                Try another search, or browse the catalog.
                <div class="form-actions">
                    <a class="btn btn-primary" asp-page="/Catalog/Keys">Browse Keys</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-shell" style="margin-top: 1rem;">
                <table>
                    <thead>
                        <tr>
                            <th>KEY #</th>
                            <th>MEDECO</th>
                            <th>Type</th>
                            <th>Rooms opened</th>
                            <th>Status</th>
                            <th>Current holder</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Results)
                    {
                        <tr>
                            <td>@item.KeyNumber</td>
                            <td>@item.MedecoKeyCode</td>
                            <td>@item.TypeCode</td>
                            <td>
                                @{
                                    string rooms = KeyOpenedRoomDisplayFormatter.Format(item.OpenedRooms);
                                }
                                @if (string.IsNullOrEmpty(rooms))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @rooms
                                }
                            </td>
                            <td>
                                @if (string.Equals(item.AvailabilityStatus, OperationalKeyAvailability.Issued, StringComparison.Ordinal))
                                {
                                    <span class="badge badge-attention">Issued</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Available</span>
                                }
                            </td>
                            <td>
                                @if (item.CurrentHolder is not null)
                                {
                                    @PartyHolderDisplayFormatter.Format(item.CurrentHolder)
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                @if (string.Equals(item.AvailabilityStatus, OperationalKeyAvailability.Issued, StringComparison.Ordinal)
                                     && !string.IsNullOrWhiteSpace(item.OpenLoanCode))
                                {
                                    <a asp-page="/Operations/Receive" asp-route-issueReference="@item.OpenLoanCode">Receive</a>
                                }
                                else
                                {
                                    <a asp-page="/Operations/Issue"
                                       asp-route-keyNumber="@item.KeyNumber"
                                       asp-route-medecoKeyCode="@item.MedecoKeyCode">Issue</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>
