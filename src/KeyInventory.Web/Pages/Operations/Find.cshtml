@page
@model KeyInventory.Web.Pages.Operations.FindModel
@{
    ViewData["Title"] = "Find Key";
    ViewData["NavSection"] = "operations";
}

<header class="page-header page-header-compact">
    <h1>Find Key</h1>
    <p class="lede">Search the catalog and active issues from one place.</p>
</header>

<section class="card form-card">
    <form method="get" class="form-grid" role="search">
        <label>
            Search
            <input type="search"
                   name="q"
                   value="@Model.Query"
                   placeholder="Search by key code, building, room or description..."
                   aria-label="Search by key code, building, room or description" />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Search</button>
            <a class="btn btn-secondary" asp-page="/Catalog/Keys">Browse Keys</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="empty-state" style="margin-top: 1rem;">
            <strong>No matching keys</strong>
            Try another search, or browse the catalog.
            <div class="form-actions">
                <a class="btn btn-primary" asp-page="/Catalog/Keys">Browse Keys</a>
            </div>
        </div>
    }
</section>