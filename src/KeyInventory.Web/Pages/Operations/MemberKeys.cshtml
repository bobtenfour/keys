@page
@using KeyInventory.Application.Lookup
@model KeyInventory.Web.Pages.Operations.MemberKeysModel
@{
    ViewData["Title"] = "Member Issued Keys";
    ViewData["NavSection"] = "operations";
}

<header class="page-header page-header-compact">
    <h1>Member Issued Keys</h1>
    <p class="lede">Keys currently issued to a workforce member through that person's Party identity.</p>
</header>

<section class="card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-page="/Administration/WorkforceMembers/Index">Workforce Members</a>
        </div>
    }
    else
    {
        <p class="lede">Workforce member: <strong>@Model.WorkforceMemberCode</strong></p>
        @if (Model.IssuedKeys.Count == 0)
        {
            <div class="empty-state">
                <strong>No currently issued keys</strong>
                This workforce member has no open loans.
            </div>
        }
        else
        {
            <div class="table-shell">
                <table>
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Holder</th>
                            <th>Issued</th>
                            <th>Due</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.IssuedKeys)
                    {
                        <tr>
                            <td>@item.CatalogKeyCode</td>
                            <td>@PartyHolderDisplayFormatter.Format(item.HolderFirstName, item.HolderLastName, item.HolderUin)</td>
                            <td>@OperatorTimestampFormatter.ToFriendlyDisplay(item.IssuedAtUtc)</td>
                            <td>@OperatorTimestampFormatter.ToFriendlyDisplay(item.DueAtUtc)</td>
                            <td><a asp-page="/Operations/Receive" asp-route-issueReference="@item.LoanCode">Receive</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="form-actions">
            <a class="btn btn-secondary" asp-page="/Administration/WorkforceMembers/Index">Back to Workforce Members</a>
            <a class="btn btn-secondary" asp-page="/Operations/Active">Active Loans</a>
        </div>
    }
</section>
