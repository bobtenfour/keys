@page
@using KeyInventory.Application.Lookup
@using KeyInventory.Domain.Loans
@model KeyInventory.Web.Pages.Operations.HistoryModel
@{
    ViewData["Title"] = "History";
    ViewData["NavSection"] = "operations";
}

<header class="page-header page-header-compact">
    <h1>History</h1>
    <p class="lede">Closed custody: Returned, Lost, and Destroyed.</p>
</header>

<section class="card">
    @if (Model.HistoryItems.Count == 0)
    {
        <div class="empty-state">
            <strong>No history yet</strong>
            Closed custody events appear here after receive, Lost, or Destroy.
            <div class="form-actions">
                <a class="btn btn-primary" asp-page="/Operations/Issue">Issue Key</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>KEY #</th>
                        <th>MEDECO</th>
                        <th>Holder</th>
                        <th>Issued</th>
                        <th>Closed</th>
                        <th>Closure</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.HistoryItems)
                {
                    <tr>
                        <td>@item.KeyNumber</td>
                        <td>@item.MedecoKeyCode</td>
                        <td>@PartyHolderDisplayFormatter.Format(item.HolderFirstName, item.HolderLastName, item.HolderUin)</td>
                        <td>@OperatorTimestampFormatter.ToFriendlyDisplay(item.IssuedAtUtc)</td>
                        <td>@(item.ReturnedAtUtc is null ? "—" : OperatorTimestampFormatter.ToFriendlyDisplay(item.ReturnedAtUtc.Value))</td>
                        <td>
                            @if (string.Equals(item.Status, nameof(LoanStatus.Returned), StringComparison.Ordinal))
                            {
                                <span class="badge badge-success">Returned</span>
                            }
                            else if (string.Equals(item.Status, nameof(LoanStatus.Lost), StringComparison.Ordinal))
                            {
                                <span class="badge badge-warning">Lost</span>
                            }
                            else if (string.Equals(item.Status, nameof(LoanStatus.Destroyed), StringComparison.Ordinal))
                            {
                                <span class="badge badge-danger">Destroyed</span>
                            }
                            else
                            {
                                <span class="badge">@item.Status</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
