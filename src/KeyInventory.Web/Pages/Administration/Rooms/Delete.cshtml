@page
@model KeyInventory.Web.Pages.Administration.Rooms.DeleteModel
@{
    ViewData["Title"] = "Delete Room";
    ViewData["NavSection"] = "administration";
    var item = Model.Item!;
}

<header class="page-header page-header-compact">
    <p class="eyebrow"><a asp-page="./Index">Rooms</a></p>
    <h1>Delete room</h1>
    <p class="lede">Delete room &quot;@item.RoomNumber&quot;?</p>
</header>

<section class="card form-card destructive-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <p>
        This permanently removes the room. Deletion is only allowed when the room has no room assignments,
        KEY #↔Room assignments, or key-issue history. Prefer Retire when history must be preserved.
    </p>

    <form method="post" class="form-grid">
        <input type="hidden" asp-for="RoomCode" />
        <label class="checkbox">
            <input asp-for="ConfirmDelete" />
            I confirm permanent deletion of room &quot;@item.RoomNumber&quot;
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete room</button>
            <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
        </div>
    </form>
</section>
