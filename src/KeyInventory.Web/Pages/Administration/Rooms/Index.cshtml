@page
@model KeyInventory.Web.Pages.Administration.Rooms.IndexModel
@{
    ViewData["Title"] = "Rooms";
    ViewData["NavSection"] = "administration";
}

<div class="page-header-row">
    <header class="page-header page-header-compact">
        <h1>Rooms</h1>
        <p class="lede">Rooms are places workforce members work and keys may open. Room number is globally unique.</p>
    </header>
    <div class="page-header-actions">
        <a class="btn btn-primary" asp-page="./Add">+ Add room</a>
    </div>
</div>

<section class="card admin-list-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    @if (Model.Rooms.Count == 0)
    {
        <div class="empty-state">
            <strong>No rooms</strong>
            Create a room before work assignments or room-based issue justification.
            <div class="form-actions">
                <a class="btn btn-primary" asp-page="./Add">Add room</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Room number</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Rooms)
                {
                    <tr>
                        <td>@item.RoomNumber</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                        <td>@(item.IsActive ? "Active" : "Retired")</td>
                        <td class="table-actions">
                            <a asp-page="./Edit" asp-route-room="@item.RoomCode">Edit</a>
                            @if (item.IsActive)
                            {
                                <form method="post" asp-page-handler="Retire" style="display:inline">
                                    <input type="hidden" name="roomCode" value="@item.RoomCode" />
                                    <button type="submit" class="btn btn-secondary">Retire</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Activate" style="display:inline">
                                    <input type="hidden" name="roomCode" value="@item.RoomCode" />
                                    <button type="submit" class="btn btn-secondary">Activate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
