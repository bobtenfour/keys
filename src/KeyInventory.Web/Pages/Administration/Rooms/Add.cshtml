@page
@model KeyInventory.Web.Pages.Administration.Rooms.AddModel
@{
    ViewData["Title"] = "Add Room";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Add Room</h1>
    <p class="lede">Create a room within a building. Room number must be unique inside its building.</p>
</header>

<section class="card form-card admin-task-form">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.BuildingOptions.Count == 0)
    {
        <div class="empty-state"><strong>Create a building first</strong></div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-page="/Administration/Buildings/Add">Add building</a>
            <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
        </div>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>
                Room code
                <input asp-for="RoomCode" autocomplete="off" required />
            </label>
            <label>
                Building
                <select asp-for="BuildingCode" asp-items="Model.BuildingOptions" required></select>
            </label>
            <label>
                Room number
                <input asp-for="RoomNumber" autocomplete="off" required />
            </label>
            <label>
                Description
                <input asp-for="Description" autocomplete="off" />
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Room</button>
                <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
            </div>
        </form>
    }
</section>
