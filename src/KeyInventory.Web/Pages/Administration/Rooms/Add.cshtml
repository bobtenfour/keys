@page
@model KeyInventory.Web.Pages.Administration.Rooms.AddModel
@{
    ViewData["Title"] = "Add Room";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Add Room</h1>
    <p class="lede">Create a room in an existing Department. Room number must be globally unique; room code is generated automatically.</p>
</header>

<section class="card form-card admin-task-form">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post" class="form-grid">
        <label>
            Department
            <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" required>
                <option value="">Select a Department...</option>
            </select>
            <span class="hint">Every Room belongs to exactly one Department. Departments are selected, not free-text.</span>
        </label>
        <label>
            Room number
            <input asp-for="RoomNumber" autocomplete="off" required />
        </label>
        <label>
            Description
            <input asp-for="Description" autocomplete="off" />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Room</button>
            <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
        </div>
    </form>
</section>
