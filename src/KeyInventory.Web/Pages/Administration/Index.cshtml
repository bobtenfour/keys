@page
@model KeyInventory.Web.Pages.Administration.IndexModel
@{
    ViewData["Title"] = "Administration";
    ViewData["NavSection"] = "administration";
}

<header class="page-header">
    <h1>Administration</h1>
    <p class="lede">Manage organizations, places, workforce members, and work assignments.</p>
</header>

<section class="card">
    <div class="toolbar">
        <a class="btn btn-primary" asp-page="/Administration/Organizations/Index">Organizations</a>
        <a class="btn btn-secondary" asp-page="/Administration/Departments/Index">Departments</a>
        <a class="btn btn-secondary" asp-page="/Administration/Buildings/Index">Buildings</a>
        <a class="btn btn-secondary" asp-page="/Administration/Rooms/Index">Rooms</a>
        <a class="btn btn-secondary" asp-page="/Administration/WorkforceMembers/Index">Workforce Members</a>
        <a class="btn btn-secondary" asp-page="/Administration/WorkAssignments/Index">Work Assignments</a>
    </div>
</section>
