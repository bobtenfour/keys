@page
@model KeyInventory.Web.Pages.Administration.WorkforceMembers.AddModel
@{
    ViewData["Title"] = "Add Workforce Member";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Add Workforce Member</h1>
    <p class="lede">Create person identity and workforce membership in one step. Identifiers are generated automatically.</p>
</header>

<section class="card form-card admin-task-form">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.DepartmentOptions.Count == 0)
    {
        <div class="empty-state">
            <strong>Create an active department first</strong>
            Workforce members require an active department.
        </div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-page="/Administration/Departments/Add">Add department</a>
            <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
        </div>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>First name<input asp-for="FirstName" required autocomplete="given-name" /></label>
            <label>Last name<input asp-for="LastName" required autocomplete="family-name" /></label>
            <label>
                UIN
                <input asp-for="Uin" required inputmode="numeric" autocomplete="off" />
                <span class="hint">Exactly nine digits.</span>
            </label>
            <label>
                Workforce type
                <select asp-for="WorkforceType">
                    <option value="Employee">Employee</option>
                    <option value="Contractor">Contractor</option>
                </select>
            </label>
            <label>
                Department
                <select asp-for="DepartmentCode" asp-items="Model.DepartmentOptions" required>
                    <option value="">Select department...</option>
                </select>
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add workforce member</button>
                <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
            </div>
        </form>
    }
</section>
