@page
@model KeyInventory.Web.Pages.Administration.WorkforceMembers.DetailsModel
@{
    ViewData["Title"] = Model.Selected is null
        ? "Workforce Member"
        : $"{Model.Selected.FirstName} {Model.Selected.LastName}";
    ViewData["NavSection"] = "administration";
    var selected = Model.Selected!;
    bool isActive = string.Equals(selected.Status, "Active", StringComparison.Ordinal);
    bool isEdit = Model.IsEditMode && isActive;
    bool justCreated = Model.JustCreated;
}

<header class="page-header page-header-compact identity-header">
    <p class="eyebrow"><a asp-page="./Index">Workforce Members</a></p>
    <h1>@selected.FirstName @selected.LastName</h1>
    <p class="identity-meta">
        <span>UIN @selected.Uin</span>
        <span class="status-pill">@selected.Status</span>
    </p>
</header>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}

@if (justCreated && isActive)
{
    <div class="next-actions" style="margin-bottom: 1rem;">
        <a class="btn btn-primary" asp-page="/Administration/WorkAssignments/Add">Assign Room</a>
        <a class="btn btn-secondary" asp-page="./Add">Add another member</a>
        <a class="btn btn-secondary" asp-page="./Index">Back to list</a>
    </div>
}

<section class="card form-card admin-task-form">
    <h2>@(isEdit ? "Edit membership" : "Membership")</h2>
    @if (isEdit)
    {
        <form method="post" asp-page-handler="Maintain" class="form-grid">
            <input type="hidden" asp-for="Member" />
            <label>First name<input asp-for="FirstName" required autocomplete="given-name" /></label>
            <label>Last name<input asp-for="LastName" required autocomplete="family-name" /></label>
            <label>
                UIN
                <input asp-for="Uin" required inputmode="numeric" autocomplete="off" />
                <span class="hint">Exactly nine digits.</span>
            </label>
            <label>
                Workforce type
                <select asp-for="WorkforceType">
                    <option value="Employee">Employee</option>
                    <option value="Contractor">Contractor</option>
                </select>
            </label>
            <label>
                Department
                <select asp-for="DepartmentCode" asp-items="Model.DepartmentOptions" required></select>
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-secondary" asp-page="./Details" asp-route-member="@selected.WorkforceMemberCode">Cancel</a>
            </div>
        </form>
    }
    else
    {
        <dl class="detail-list search-person-identity">
            <div><dt>Name</dt><dd>@selected.FirstName @selected.LastName</dd></div>
            <div><dt>UIN</dt><dd>@selected.Uin</dd></div>
            <div><dt>Workforce type</dt><dd>@selected.WorkforceType</dd></div>
            <div><dt>Department</dt><dd>@selected.DepartmentCode</dd></div>
            <div><dt>Status</dt><dd>@selected.Status</dd></div>
        </dl>
        <div class="form-actions">
            @if (isActive)
            {
                <a class="btn btn-primary"
                   asp-page="./Details"
                   asp-route-member="@selected.WorkforceMemberCode"
                   asp-route-edit="true">Edit</a>
            }
            <a class="btn btn-secondary" asp-page="./Index">Back to list</a>
            <a class="btn btn-secondary" asp-page="/Administration/AuditTrail" asp-route-Subject="@selected.WorkforceMemberCode">Audit history</a>
        </div>
        @if (!isActive)
        {
            <p class="hint">Terminated members cannot be reactivated or edited.</p>
        }
    }
</section>

<section class="card admin-list-panel">
    <h2>Room Assignments</h2>
    @if (Model.RoomAssignments.Count == 0)
    {
        <div class="empty-state"><strong>No active room assignments</strong></div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.RoomAssignments)
                {
                    <tr>
                        <td>@item.RoomNumber</td>
                        <td>@(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="form-actions">
        @if (isActive)
        {
            <a class="btn btn-secondary" asp-page="/Administration/WorkAssignments/Add">Assign Room</a>
        }
        <a class="btn btn-secondary" asp-page="/Administration/WorkAssignments/Index">Manage room assignments</a>
    </div>
</section>

<section class="card admin-list-panel">
    <h2>Currently issued keys</h2>
    @if (Model.IssuedKeys.Count == 0)
    {
        <div class="empty-state"><strong>No currently issued keys</strong></div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>KEY #</th>
                        <th>MEDECO</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.IssuedKeys)
                {
                    <tr>
                        <td>@item.KeyNumber</td>
                        <td>@item.MedecoKeyCode</td>
                        <td>@OperatorTimestampFormatter.ToFriendlyDisplay(item.IssuedAtUtc)</td>
                        <td>@OperatorTimestampFormatter.ToFriendlyDisplay(item.DueAtUtc)</td>
                        <td><a asp-page="/Operations/Receive" asp-route-issueReference="@item.LoanCode">Receive</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (isActive && !justCreated)
{
    <section class="card form-card destructive-panel" aria-label="Lifecycle actions">
        <h2>Lifecycle</h2>
        <p class="lede">Termination ends eligibility for new key issues. Outstanding keys must still be received through Receive.</p>
        @if (Model.Obligations.Count > 0)
        {
            <div class="alert alert-warning" role="status">
                Outstanding return obligations: @Model.Obligations.Count
            </div>
        }
        <form method="post" asp-page-handler="Terminate" class="form-grid">
            <input type="hidden" asp-for="Member" />
            <label class="checkbox">
                <input asp-for="ConfirmTerminate" />
                I confirm termination of @selected.FirstName @selected.LastName
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Terminate workforce member</button>
            </div>
        </form>
    </section>
}
