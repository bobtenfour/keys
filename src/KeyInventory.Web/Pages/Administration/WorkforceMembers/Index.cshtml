@page
@model KeyInventory.Web.Pages.Administration.WorkforceMembers.IndexModel
@{
    ViewData["Title"] = "Workforce Members";
    ViewData["NavSection"] = "administration";
}

<div class="page-header-row">
    <header class="page-header page-header-compact">
        <h1>Workforce Members</h1>
        <p class="lede">People with an active or terminated workforce relationship for key eligibility.</p>
    </header>
    <div class="page-header-actions">
        <a class="btn btn-primary" asp-page="./Add">+ Add workforce member</a>
    </div>
</div>

<section class="card admin-list-panel">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    <form method="get" class="toolbar admin-filter-bar" role="search">
        <label class="admin-filter-field">
            <span class="visually-hidden">Search workforce members</span>
            <input type="search" name="Q" value="@Model.Q" placeholder="Search name, UIN, department…" />
        </label>
        <button type="submit" class="btn btn-secondary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q))
        {
            <a class="btn btn-secondary" asp-page="./Index">Clear</a>
        }
    </form>

    @if (Model.Members.Count == 0)
    {
        <div class="empty-state">
            <strong>No workforce members</strong>
            @(string.IsNullOrWhiteSpace(Model.Q)
                ? "Add a workforce member to begin eligibility setup."
                : "No members match this search.")
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>UIN</th>
                        <th>Type</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Members)
                {
                    <tr>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@item.Uin</td>
                        <td>@item.WorkforceType</td>
                        <td>@item.DepartmentCode</td>
                        <td>@item.Status</td>
                        <td class="table-actions">
                            <a asp-page="./Details" asp-route-member="@item.WorkforceMemberCode">View/Edit</a>
                            <a asp-page="/Operations/MemberKeys" asp-route-member="@item.WorkforceMemberCode">Issued Keys</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
