@page
@model KeyInventory.Web.Pages.Administration.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Departments</h1>
    <p class="lede">Organizational units used for workforce membership and key-issue justification.</p>
</header>

<section class="card form-card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    @if (Model.OrganizationOptions.Count == 0)
    {
        <div class="empty-state">
            <strong>Create an organization first</strong>
        </div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-page="/Administration/Organizations/Index">Organizations</a>
        </div>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>
                Organization
                <select asp-for="OrganizationCode" asp-items="Model.OrganizationOptions" required></select>
            </label>
            <label>
                Department code
                <input asp-for="DepartmentCode" autocomplete="off" required />
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Department</button>
                <a class="btn btn-secondary" asp-page="/Administration/Index">Back</a>
            </div>
        </form>
    }
</section>

<section class="card">
    @if (Model.Departments.Count == 0)
    {
        <div class="empty-state"><strong>No departments</strong></div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Organization</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Departments)
                {
                    <tr>
                        <td>@item.OrganizationCode</td>
                        <td>@item.DepartmentCode</td>
                        <td>@(item.IsActive ? "Active" : "Retired")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <form method="post" asp-page-handler="Retire" style="display:inline">
                                    <input type="hidden" name="organizationCode" value="@item.OrganizationCode" />
                                    <input type="hidden" name="departmentCode" value="@item.DepartmentCode" />
                                    <button type="submit" class="btn btn-secondary">Retire</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Activate" style="display:inline">
                                    <input type="hidden" name="organizationCode" value="@item.OrganizationCode" />
                                    <input type="hidden" name="departmentCode" value="@item.DepartmentCode" />
                                    <button type="submit" class="btn btn-secondary">Activate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
