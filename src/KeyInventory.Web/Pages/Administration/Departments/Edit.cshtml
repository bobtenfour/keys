@page "{departmentId:guid}"
@model KeyInventory.Web.Pages.Administration.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
    ViewData["NavSection"] = "administration";
    var selected = Model.Selected!;
}

<header class="page-header page-header-compact">
    <p class="eyebrow"><a asp-page="./Index">Departments</a></p>
    <h1>Edit @selected.DepartmentCode</h1>
    <p class="lede">Update the department. Department identity is stable and is not editable.</p>
</header>

<section class="card form-card admin-task-form">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    <form method="post" class="form-grid">
        <input type="hidden" asp-for="DepartmentId" />
        <label>
            Department
            <input asp-for="DepartmentCode" autocomplete="off" required />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-secondary" asp-page="./Index">Back to list</a>
        </div>
    </form>
</section>
