@page "{departmentId:guid}"
@model KeyInventory.Web.Pages.Administration.Departments.DeleteModel
@{
    ViewData["Title"] = "Delete Department";
    ViewData["NavSection"] = "administration";
    var item = Model.Item!;
}

<header class="page-header page-header-compact">
    <p class="eyebrow"><a asp-page="./Index">Departments</a></p>
    <h1>Delete department</h1>
    <p class="lede">Delete department &quot;@item.DepartmentCode&quot;?</p>
</header>

<section class="card form-card destructive-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <p>
        This permanently removes the department. Deletion is only allowed when the department has no
        workforce members and is not used as loan justification history. Prefer Retire when history must be preserved.
    </p>

    <form method="post" class="form-grid">
        <input type="hidden" asp-for="DepartmentId" />
        <label class="checkbox">
            <input asp-for="ConfirmDelete" />
            I confirm permanent deletion of department &quot;@item.DepartmentCode&quot;
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete department</button>
            <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
        </div>
    </form>
</section>
