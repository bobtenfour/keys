@page
@model KeyInventory.Web.Pages.Administration.Buildings.IndexModel
@{
    ViewData["Title"] = "Buildings";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Buildings</h1>
    <p class="lede">Physical buildings that contain rooms.</p>
</header>

<section class="card form-card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    <form method="post" class="form-grid">
        <label>
            Building code
            <input asp-for="BuildingCode" autocomplete="off" required />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Building</button>
            <a class="btn btn-secondary" asp-page="/Administration/Index">Back</a>
        </div>
    </form>
</section>

<section class="card">
    @if (Model.Buildings.Count == 0)
    {
        <div class="empty-state"><strong>No buildings</strong></div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Building</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Buildings)
                {
                    <tr>
                        <td>@item.BuildingCode</td>
                        <td>@(item.IsActive ? "Active" : "Inactive")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
