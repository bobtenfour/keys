@page
@model KeyInventory.Web.Pages.Administration.AuditTrailModel
@{
    ViewData["Title"] = "Audit Trail";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Audit Trail</h1>
    <p class="lede">Who performed which business action, when, and which record was affected.</p>
</header>

<section class="card form-card admin-list-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="get" class="form-grid" role="search">
        <label>
            From
            <input asp-for="FromLocal" type="datetime-local" />
        </label>
        <label>
            To
            <input asp-for="ToLocal" type="datetime-local" />
        </label>
        <label>
            Operator
            <input asp-for="Operator" autocomplete="off" placeholder="User name..." />
        </label>
        <label>
            Action
            <select asp-for="Action" asp-items="Model.ActionOptions">
                <option value="">All actions</option>
            </select>
        </label>
        <label>
            Subject / reference
            <input asp-for="Subject" autocomplete="off" placeholder="Key, member, org..." />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Apply filters</button>
            <a class="btn btn-secondary" asp-page="./AuditTrail">Clear</a>
            <a class="btn btn-secondary"
               asp-page="./AuditTrail"
               asp-page-handler="Export"
               asp-route-format="csv"
               asp-route-FromLocal="@Model.FromLocal"
               asp-route-ToLocal="@Model.ToLocal"
               asp-route-Operator="@Model.Operator"
               asp-route-Action="@Model.Action"
               asp-route-Subject="@Model.Subject">CSV</a>
            <a class="btn btn-secondary"
               asp-page="./AuditTrail"
               asp-page-handler="Export"
               asp-route-format="xlsx"
               asp-route-FromLocal="@Model.FromLocal"
               asp-route-ToLocal="@Model.ToLocal"
               asp-route-Operator="@Model.Operator"
               asp-route-Action="@Model.Action"
               asp-route-Subject="@Model.Subject">Excel</a>
            <a class="btn btn-secondary"
               asp-page="./AuditTrail"
               asp-page-handler="Export"
               asp-route-format="pdf"
               asp-route-FromLocal="@Model.FromLocal"
               asp-route-ToLocal="@Model.ToLocal"
               asp-route-Operator="@Model.Operator"
               asp-route-Action="@Model.Action"
               asp-route-Subject="@Model.Subject">PDF</a>
        </div>
    </form>
</section>

<section class="card admin-list-panel">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <strong>No audit records</strong>
            No persisted operator actions match these filters.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>Operator</th>
                        <th>Action</th>
                        <th>Subject</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Rows)
                {
                    <tr>
                        <td>@OperatorTimestampFormatter.ToFriendlyDisplay(item.OccurredAtUtc)</td>
                        <td>@item.OperatorReference</td>
                        <td>@item.ActionType</td>
                        <td>@item.SubjectType: @item.SubjectReference</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Details) ? "—" : item.Details)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
