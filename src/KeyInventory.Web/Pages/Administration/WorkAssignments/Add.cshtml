@page
@model KeyInventory.Web.Pages.Administration.WorkAssignments.AddModel
@{
    ViewData["Title"] = "Add Work Assignment";
    ViewData["NavSection"] = "administration";
}

<header class="page-header page-header-compact">
    <h1>Add Work Assignment</h1>
    <p class="lede">Assign a workforce member to a room. One active assignment may be primary.</p>
</header>

<section class="card form-card admin-task-form">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.MemberOptions.Count == 0 || Model.RoomOptions.Count == 0)
    {
        <div class="empty-state">
            <strong>Active workforce members and rooms are required</strong>
        </div>
        <div class="form-actions">
            <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
        </div>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>Work assignment code<input asp-for="WorkAssignmentCode" required /></label>
            <label>
                Workforce member
                <select asp-for="WorkforceMemberCode" asp-items="Model.MemberOptions" required>
                    <option value="">Select member...</option>
                </select>
            </label>
            <label>
                Room
                <select asp-for="RoomCode" asp-items="Model.RoomOptions" required>
                    <option value="">Select room...</option>
                </select>
            </label>
            <label class="checkbox">
                <input asp-for="IsPrimary" />
                Primary assignment
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Work Assignment</button>
                <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
            </div>
        </form>
    }
</section>
