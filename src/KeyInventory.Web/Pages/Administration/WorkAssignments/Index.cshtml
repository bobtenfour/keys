@page
@model KeyInventory.Web.Pages.Administration.WorkAssignments.IndexModel
@{
    ViewData["Title"] = "Work Assignments";
    ViewData["NavSection"] = "administration";
}

<div class="page-header-row">
    <header class="page-header page-header-compact">
        <h1>Work Assignments</h1>
        <p class="lede">Assign workforce members to rooms. One active assignment may be primary.</p>
    </header>
    <div class="page-header-actions">
        <a class="btn btn-primary" asp-page="./Add">+ Add work assignment</a>
    </div>
</div>

<section class="card admin-list-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    @if (Model.Assignments.Count == 0)
    {
        <div class="empty-state"><strong>No work assignments</strong></div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th>Member</th>
                        <th>Room</th>
                        <th>Primary</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Assignments)
                {
                    <tr>
                        <td>@item.WorkAssignmentCode</td>
                        <td>@Model.FormatMember(item.WorkforceMemberCode)</td>
                        <td>@Model.FormatRoom(item.RoomCode)</td>
                        <td>@(item.IsPrimary ? "Yes" : "No")</td>
                        <td>@(item.IsActive ? "Active" : "Ended")</td>
                        <td class="table-actions">
                            @if (item.IsActive)
                            {
                                @if (!item.IsPrimary)
                                {
                                    <form method="post" asp-page-handler="MarkPrimary" style="display:inline">
                                        <input type="hidden" name="workAssignmentCode" value="@item.WorkAssignmentCode" />
                                        <button type="submit" class="btn btn-secondary">Make primary</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ClearPrimary" style="display:inline">
                                        <input type="hidden" name="workAssignmentCode" value="@item.WorkAssignmentCode" />
                                        <button type="submit" class="btn btn-secondary">Clear primary</button>
                                    </form>
                                }
                            }
                            @if (item.Capabilities.CanDelete)
                            {
                                <a class="btn btn-danger"
                                   asp-page="./Delete"
                                   asp-route-workAssignmentCode="@item.WorkAssignmentCode">Delete</a>
                            }
                            @if (item.Capabilities.CanEnd)
                            {
                                <form method="post" asp-page-handler="End" style="display:inline">
                                    <input type="hidden" name="workAssignmentCode" value="@item.WorkAssignmentCode" />
                                    <button type="submit" class="btn btn-secondary">End</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
