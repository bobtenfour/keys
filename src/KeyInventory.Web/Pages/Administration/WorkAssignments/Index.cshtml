@page
@model KeyInventory.Web.Pages.Administration.WorkAssignments.IndexModel
@{
    ViewData["Title"] = "Room Assignments";
    ViewData["NavSection"] = "administration";
}

<div class="page-header-row">
    <header class="page-header page-header-compact">
        <h1>Room Assignments</h1>
        <p class="lede">Active assignments of workforce members to Rooms in the same Department.</p>
    </header>
    <div class="page-header-actions">
        <a class="btn btn-primary" asp-page="./Add">Assign Room</a>
    </div>
</div>

<section class="card admin-list-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    @if (Model.Assignments.Count == 0)
    {
        <div class="empty-state"><strong>No room assignments</strong></div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Assignments)
                {
                    <tr>
                        <td>@Model.FormatMember(item.WorkforceMemberCode)</td>
                        <td>@Model.FormatRoom(item.RoomCode)</td>
                        <td>@(item.IsActive ? "Active" : "Ended")</td>
                        <td class="table-actions">
                            @if (item.Capabilities.CanDelete)
                            {
                                <a class="btn btn-danger"
                                   asp-page="./Delete"
                                   asp-route-workAssignmentId="@item.WorkAssignmentId">Delete</a>
                            }
                            @if (item.Capabilities.CanEnd)
                            {
                                <form method="post" asp-page-handler="End" style="display:inline">
                                    <input type="hidden" name="workAssignmentId" value="@item.WorkAssignmentId" />
                                    <button type="submit" class="btn btn-secondary">End</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
