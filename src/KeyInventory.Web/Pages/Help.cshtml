                        <rect x="88" y="24" width="56" height="28" rx="3" fill="#e8eef7" stroke="#00205B"/><text x="116" y="42" text-anchor="middle" fill="#0B1F3A" font-size="9">KEY #</text>
                        <rect x="156" y="24" width="56" height="28" rx="3" fill="#fff" stroke="#00859B"/><text x="184" y="42" text-anchor="middle" fill="#0B1F3A" font-size="9">MEDECO</text>
                        <rect x="224" y="24" width="56" height="28" rx="3" fill="#e8f5e9" stroke="#00859B"/><text x="252" y="42" text-anchor="middle" fill="#0B1F3A" font-size="9">Rooms</text>
                        <rect x="292" y="24" width="68" height="28" rx="3" fill="#e6f4f7" stroke="#00859B"/><text x="326" y="42" text-anchor="middle" fill="#0B1F3A" font-size="9">Justify</text>
                        <rect x="372" y="24" width="56" height="28" rx="3" fill="#e6f4f7" stroke="#00859B"/><text x="400" y="42" text-anchor="middle" fill="#0B1F3A" font-size="9">Loan #</text>
                        <rect x="440" y="24" width="32" height="28" rx="3" fill="#e8f5e9" stroke="#00859B"/><text x="456" y="42" text-anchor="middle" fill="#0B1F3A" font-size="9">✓</text>
