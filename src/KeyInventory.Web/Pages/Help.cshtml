                        <rect x="140" y="36" width="140" height="32" rx="4" fill="#e8eef7" stroke="#00205B"/><text x="210" y="56" text-anchor="middle" fill="#0B1F3A" font-size="10" font-weight="700">KEY # MASTER1</text>
