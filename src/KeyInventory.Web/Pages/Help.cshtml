                        <text x="16" y="22" fill="#00205B" font-size="11" font-weight="700">HELP-DIAGRAM-06 · Return &amp; copy independence</text>
                        <rect x="150" y="36" width="120" height="28" rx="4" fill="#e8eef7" stroke="#00205B"/><text x="210" y="54" text-anchor="middle" fill="#0B1F3A" font-size="10">KEY # 66800</text>
                        <rect x="40" y="80" width="80" height="28" rx="4" fill="#e8f5e9" stroke="#00859B"/><text x="80" y="98" text-anchor="middle" fill="#0B1F3A" font-size="9">MED 26 returned</text>
                        <rect x="170" y="80" width="80" height="28" rx="4" fill="#fff" stroke="#D50032"/><text x="210" y="98" text-anchor="middle" fill="#0B1F3A" font-size="9">MED 27 issued</text>
