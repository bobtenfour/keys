@page
@model KeyInventory.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<header class="page-header">
    <h1>Log in</h1>
    <p class="lede">Sign in to the KeyInventory operations workstation.</p>
</header>

<section class="card form-card">
    <form method="post" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <label>
            Username
            <input asp-for="Input.UserName" autocomplete="username" required />
        </label>
        <label>
            Password
            <input asp-for="Input.Password" autocomplete="current-password" required />
        </label>
        <input type="hidden" name="returnPath" value="@Model.ReturnPath" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Log in</button>
        </div>
    </form>
</section>
