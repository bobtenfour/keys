@page
@using KeyInventory.Application.Catalog
@using KeyInventory.Application.Lookup
@using KeyInventory.Domain.Catalog
@model KeyInventory.Web.Pages.Catalog.KeysModel
@{
    ViewData["Title"] = "Keys";
    ViewData["NavSection"] = "catalog";
}

<header class="page-header page-header-compact">
    <h1>Keys</h1>
    <p class="lede">KEY # access patterns and keys.</p>
</header>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}

<section class="card">
    <div class="toolbar">
        <a class="btn btn-primary" asp-page="/Catalog/Register">Create Key</a>
        <a class="btn btn-secondary" asp-page="/Operations/Issue">Issue Key</a>
    </div>

    <h2 class="section-title">KEY # access patterns</h2>
    @if (Model.AccessPatterns.Count == 0)
    {
        <div class="empty-state">
            <strong>No KEY # patterns</strong>
            Create a key to establish a KEY #.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>KEY #</th>
                        <th>Classification</th>
                        <th>Keys</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var pattern in Model.AccessPatterns)
                {
                    <tr>
                        <td>@pattern.KeyNumber</td>
                        <td>@pattern.Classification</td>
                        <td>@pattern.PhysicalCopyCount</td>
                        <td>@(pattern.IsActive ? "Active" : "Retired")</td>
                        <td class="table-actions">
                            @if (pattern.Capabilities.CanDelete)
                            {
                                <a class="btn btn-danger"
                                   asp-page="/Catalog/Keys/DeletePattern"
                                   asp-route-keyNumber="@pattern.KeyNumber">Delete</a>
                            }
                            @if (pattern.Capabilities.CanRetire)
                            {
                                <form method="post" asp-page-handler="RetirePattern" style="display:inline">
                                    <input type="hidden" name="keyNumber" value="@pattern.KeyNumber" />
                                    <button type="submit" class="btn btn-secondary">Retire</button>
                                </form>
                            }
                            @if (pattern.Capabilities.CanActivate)
                            {
                                <form method="post" asp-page-handler="ActivatePattern" style="display:inline">
                                    <input type="hidden" name="keyNumber" value="@pattern.KeyNumber" />
                                    <button type="submit" class="btn btn-secondary">Activate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <h2 class="section-title">Keys</h2>
    @if (Model.Keys.Count == 0)
    {
        <div class="empty-state">
            <strong>No keys</strong>
            Create your first key using the button above.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>KEY #</th>
                        <th>MEDECO</th>
                        <th>Classification</th>
                        <th>Access</th>
                        <th>Condition</th>
                        <th>Custody</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var key in Model.Keys)
                {
                    <tr>
                        <td>@key.KeyNumber</td>
                        <td>@key.MedecoKeyCode</td>
                        <td>@key.Classification</td>
                        <td>
                            @{
                                IReadOnlyList<KeyOpenedRoomItem> opened =
                                    Model.OpenedRoomsByAssetId.TryGetValue(key.KeyAssetId, out var rooms)
                                        ? rooms
                                        : [];
                                string accessText = KeyOpenedRoomDisplayFormatter.FormatAccess(key.Classification, opened);
                            }
                            @if (string.IsNullOrEmpty(accessText))
                            {
                                <span>—</span>
                            }
                            else
                            {
                                @accessText
                            }
                        </td>
                        <td>
                            @if (key.Condition == KeyPhysicalCondition.Lost)
                            {
                                <span class="badge badge-warning">Lost</span>
                            }
                            else if (key.Condition == KeyPhysicalCondition.Destroyed)
                            {
                                <span class="badge badge-danger">Destroyed</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Active</span>
                            }
                        </td>
                        <td>
                            @if (key.Condition != KeyPhysicalCondition.Active)
                            {
                                <span>—</span>
                            }
                            else if (string.Equals(
                                         key.AvailabilityStatus,
                                         OperationalKeyAvailability.Issued,
                                         StringComparison.Ordinal))
                            {
                                <span class="badge badge-attention">Issued</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Available</span>
                            }
                        </td>
                        <td class="table-actions">
                            @if (key.CanMarkLost)
                            {
                                <form method="post" asp-page-handler="MarkLost" style="display:inline">
                                    <input type="hidden" name="keyAssetId" value="@key.KeyAssetId" />
                                    <button type="submit" class="btn btn-secondary">Mark Lost</button>
                                </form>
                            }
                            @if (key.CanReplace)
                            {
                                <a class="btn btn-secondary"
                                   asp-page="/Catalog/Register"
                                   asp-route-mode="Replace">Replace</a>
                            }
                            @if (key.CanDestroy)
                            {
                                <form method="post" asp-page-handler="Destroy" style="display:inline">
                                    <input type="hidden" name="keyAssetId" value="@key.KeyAssetId" />
                                    <button type="submit" class="btn btn-danger">Destroy</button>
                                </form>
                            }
                            @if (key.Capabilities.CanDelete)
                            {
                                <a class="btn btn-danger"
                                   asp-page="/Catalog/Keys/Delete"
                                   asp-route-keyAssetId="@key.KeyAssetId">Delete</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
