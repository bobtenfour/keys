@page
@using KeyInventory.Application.Catalog
@model KeyInventory.Web.Pages.Catalog.KeysModel
@{
    ViewData["Title"] = "Keys";
    ViewData["NavSection"] = "catalog";
}

<header class="page-header page-header-compact">
    <h1>Keys</h1>
    <p class="lede">Physical MEDECO copies under KEY # access patterns.</p>
</header>

<section class="card">
    <div class="toolbar">
        <a class="btn btn-primary" asp-page="/Catalog/Register">Register Key</a>
        <a class="btn btn-secondary" asp-page="/Operations/Issue">Issue Key</a>
    </div>

    @if (Model.Keys.Count == 0)
    {
        <div class="empty-state">
            <strong>No keys registered</strong>
            Register your first physical copy using the button above.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>KEY #</th>
                        <th>MEDECO</th>
                        <th>Type</th>
                        <th>Rooms opened</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var key in Model.Keys)
                {
                    <tr>
                        <td>@key.KeyNumber</td>
                        <td>@key.MedecoKeyCode</td>
                        <td>@key.TypeCode</td>
                        <td>
                            @{
                                string rooms = KeyOpenedRoomDisplayFormatter.Format(key.OpenedRooms);
                            }
                            @if (string.IsNullOrEmpty(rooms))
                            {
                                <span>—</span>
                            }
                            else
                            {
                                @rooms
                            }
                        </td>
                        <td>
                            @if (!key.IsActive)
                            {
                                <span class="badge badge-warning">Inactive</span>
                            }
                            else if (Model.IssuedKeyAssetIds.Contains(key.KeyAssetId))
                            {
                                <span class="badge badge-attention">Issued</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Available</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Catalog/KeyRooms" asp-route-keyNumber="@key.KeyNumber">Rooms</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
