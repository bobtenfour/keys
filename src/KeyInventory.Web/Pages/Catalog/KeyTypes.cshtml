@page
@model KeyInventory.Web.Pages.Catalog.KeyTypesModel
@{
    ViewData["Title"] = "Key Types";
    ViewData["NavSection"] = "catalog";
}

<header class="page-header">
    <h1>Key Types</h1>
    <p class="lede">Catalog key types. Retire only when no active keys require the type.</p>
</header>

<section class="card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
    }

    <div class="toolbar">
        <a class="btn btn-primary" asp-page="/Catalog/KeyTypes/Add">Add Key Type</a>
        <a class="btn btn-secondary" asp-page="/Catalog/Register">Register Key</a>
    </div>

    @if (Model.KeyTypes.Count == 0)
    {
        <div class="empty-state">
            <strong>No key types yet</strong>
            Create a Key Type before registering a new KEY #.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Active keys</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var type in Model.KeyTypes)
                {
                    <tr>
                        <td>@type.TypeCode</td>
                        <td>@type.ActiveKeyAccessPatternCount</td>
                        <td>@(type.IsActive ? "Active" : "Retired")</td>
                        <td class="table-actions">
                            @if (type.Capabilities.CanDelete)
                            {
                                <a class="btn btn-danger"
                                   asp-page="/Catalog/KeyTypes/Delete"
                                   asp-route-typeCode="@type.TypeCode">Delete</a>
                            }
                            @if (type.Capabilities.CanRetire)
                            {
                                <form method="post" asp-page-handler="Retire" style="display:inline">
                                    <input type="hidden" name="typeCode" value="@type.TypeCode" />
                                    <button type="submit" class="btn btn-secondary">Retire</button>
                                </form>
                            }
                            @if (type.Capabilities.CanActivate)
                            {
                                <form method="post" asp-page-handler="Activate" style="display:inline">
                                    <input type="hidden" name="typeCode" value="@type.TypeCode" />
                                    <button type="submit" class="btn btn-secondary">Activate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
