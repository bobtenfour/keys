@page
@model KeyInventory.Web.Pages.Catalog.RegisterModel
@{
    ViewData["Title"] = "Register Key";
    ViewData["NavSection"] = "catalog";
}

<header class="page-header">
    <h1>Register Key</h1>
    <p class="lede">Register a physical MEDECO copy under a KEY #. A new KEY # is created when needed.</p>
</header>

<section class="card form-card">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
        <div class="next-actions">
            <a class="btn btn-primary" asp-page="/Catalog/Register">Register another copy</a>
            <a class="btn btn-secondary" asp-page="/Operations/Issue">Issue key</a>
            <a class="btn btn-secondary" asp-page="/Index">Return to Operations</a>
        </div>
    }
    else
    {
        <form method="post" class="form-grid">
            <label>
                KEY #
                <input asp-for="KeyNumber" autocomplete="off" required />
            </label>
            <label>
                MEDECO Key Code
                <input asp-for="MedecoKeyCode" autocomplete="off" required />
                <span class="hint">Unique within this KEY #. The same MEDECO may exist under another KEY #.</span>
            </label>
            <label>
                Key type
                <input asp-for="TypeCode" autocomplete="off" required />
                <span class="hint">Owned by the KEY #. Existing KEY # values must keep their type. New types are created when needed.</span>
            </label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Register Key</button>
                <a class="btn btn-secondary" asp-page="/Catalog/Keys">Cancel</a>
            </div>
        </form>
    }
</section>
