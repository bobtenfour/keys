@page
@model KeyInventory.Web.Pages.Reports.CurrentKeyHoldersModel
@{
    ViewData["Title"] = "Current Key Holders";
    ViewData["NavSection"] = "reports";
}

<header class="page-header page-header-compact">
    <h1>Current Key Holders</h1>
    <p class="lede">Currently issued keys with holder identity and due dates.</p>
</header>

<section class="card form-card">
    <form method="get" class="form-grid" role="search">
        <label>
            Key filter
            <input type="search" name="key" value="@Model.KeyFilter" placeholder="Partial key code..." />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a class="btn btn-secondary" asp-page="/Reports/CurrentKeyHolders" asp-page-handler="Export" asp-route-key="@Model.KeyFilter">Export CSV</a>
            <a class="btn btn-secondary" asp-page="/Reports/Index">All Reports</a>
        </div>
    </form>
</section>

<section class="card">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <strong>No current key holders</strong>
            There are no open loans matching this filter.
        </div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Holder</th>
                        <th>Workforce Member</th>
                        <th>Department</th>
                        <th>Responsible Manager</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.CatalogKeyCode</td>
                        <td>@PartyHolderDisplayFormatter.Format(row.HolderFirstName, row.HolderLastName, row.HolderUin)</td>
                        <td>@(row.WorkforceMemberCode ?? "—")</td>
                        <td>@(row.DepartmentCode ?? "—")</td>
                        <td>@(row.ResponsibleManagerWorkforceMemberCode ?? "—")</td>
                        <td>@OperatorTimestampFormatter.ToFriendlyDisplay(row.IssuedAtUtc)</td>
                        <td>@OperatorTimestampFormatter.ToFriendlyDisplay(row.DueAtUtc)</td>
                        <td>@row.Status</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
